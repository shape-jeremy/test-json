{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/baseSchema",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "name": { "type": "string" },
    "age": { "type": "integer" },
    "status": { "type": "string", "enum": ["active", "inactive"] }
  },
  "required": ["id", "name"]
}
